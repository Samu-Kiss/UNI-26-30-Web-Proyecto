# ==============================================================================
# Sentry Observability (DSN es configuración pública; no colocar tokens secretos)
# ==============================================================================
# Backend (Spring Boot / Java)
SENTRY_DSN=https://examplePublicKey@o0000000.ingest.sentry.io/0000000
SENTRY_ENVIRONMENT=local
SENTRY_RELEASE=myt@dev
SENTRY_TRACES_SAMPLE_RATE=0.0

# Frontend (Angular 22)
SENTRY_FRONTEND_DSN=https://examplePublicKey@o0000000.ingest.sentry.io/0000000
SENTRY_FRONTEND_ENVIRONMENT=local
SENTRY_FRONTEND_RELEASE=myt-frontend@dev
SENTRY_FRONTEND_TRACES_SAMPLE_RATE=0.0

# ==============================================================================
# Supabase & PostgreSQL (Backend JDBC)
# ==============================================================================
# Development is used automatically when no profile is provided.
SPRING_PROFILES_ACTIVE=dev
SUPABASE_DEV_DB_URL=jdbc:postgresql://aws-0-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DEV_DB_USERNAME=postgres.your-dev-project-ref
SUPABASE_DEV_DB_PASSWORD=YOUR_DEV_DATABASE_PASSWORD

# Production is only used with SPRING_PROFILES_ACTIVE=prod.
SUPABASE_PROD_DB_URL=jdbc:postgresql://aws-0-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_PROD_DB_USERNAME=postgres.your-prod-project-ref
SUPABASE_PROD_DB_PASSWORD=YOUR_PROD_DATABASE_PASSWORD

DB_SCHEMA=app
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1
DB_CONNECTION_TIMEOUT_MS=30000
JPA_SHOW_SQL=false

# ==============================================================================
# Supabase Client API (Para futura integración directa de Frontend)
# ==============================================================================
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY
