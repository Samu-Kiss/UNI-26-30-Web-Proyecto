# Backend observability. The DSN is public configuration; never put the auth token here.
SENTRY_DSN=https://c4030b0cfb10c760b3b1534427dd5c6c@o4511549920116736.ingest.us.sentry.io/4512006192693248
SENTRY_ENVIRONMENT=local
SENTRY_RELEASE=myt@dev
