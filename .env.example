# PostgreSQL / Supabase. Copy the JDBC URL from Connect > Session pooler (port 5432).
# Percent-encode reserved characters in the password before placing it in the URL.
SUPABASE_DB_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?user=postgres.PROJECT_REF&password=YOUR_URL_ENCODED_PASSWORD&sslmode=require
DB_SCHEMA=app
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1
DB_CONNECTION_TIMEOUT_MS=30000
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
